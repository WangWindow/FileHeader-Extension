{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "bun: compile",
      "type": "shell",
      "command": "bun run compile",
      "group": "build",
      "problemMatcher": "$tsc"
    },
    {
      "label": "bun: watch",
      "type": "shell",
      "command": "bun run watch",
      "isBackground": true,
      "problemMatcher": "$tsc-watch",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
